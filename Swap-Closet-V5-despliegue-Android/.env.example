# Copia este archivo como .env y rellena los valores reales
# cp .env.example .env

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=swap_closet
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esto

# ── Cloudinary ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ── JWT ─────────────────────────────────────────────────────
# Mínimo 32 caracteres, genera uno con: openssl rand -base64 32
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_seguro
